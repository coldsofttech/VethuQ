{
  "name": "vethuq-metrics-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Receives the anonymous metrics VethuQ users opt in to share. A Cloudflare Worker with a D1 database.",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply vethuq-metrics --remote"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "wrangler": "^4.20.0"
  }
}
