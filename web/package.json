{
  "name": "vethuq-web",
  "private": true,
  "version": "0.1.0",
  "description": "VethuQ user interface: React + Fluent UI, served by the Flask API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "lint": "eslint . && cd ../viewers/text && node ../../web/node_modules/eslint/bin/eslint.js . && cd ../csv && node ../../web/node_modules/eslint/bin/eslint.js . && cd ../markdown && node ../../web/node_modules/eslint/bin/eslint.js . && cd ../html && node ../../web/node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write . ../viewers",
    "format:check": "prettier --check . ../viewers",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@vethuq/csv-viewer": "file:../viewers/csv",
    "@vethuq/html-viewer": "file:../viewers/html",
    "@vethuq/markdown-viewer": "file:../viewers/markdown",
    "@vethuq/text-viewer": "file:../viewers/text",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
